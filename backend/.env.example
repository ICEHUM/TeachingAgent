# Copy to .env and fill the key locally. Never place credentials in frontend code.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com

# Separate roles and fixed search_path are configured by deploy/bootstrap-postgres.sql.
TEACHING_DATABASE_URL=postgresql+psycopg://teaching_app@localhost/teaching_agent
LANGGRAPH_CHECKPOINT_DATABASE_URL=postgresql://langgraph_cp@localhost/teaching_agent
LANGGRAPH_STRICT_MSGPACK=true
